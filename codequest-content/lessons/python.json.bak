        "expected_output": "8",
        "description": "add_strings('5', '3') 应返回 8"
      },
      {
        "input": "add_strings('0', '0')",
        "expected_output": "0",
        "description": "add_strings('0', '0') 应返回 0（零值边界）"
      },
      {
        "input": "greet('')",
        "expected_output": "你好, !",
        "description": "greet('') 应返回问候语（空字符串边界）"
      }
