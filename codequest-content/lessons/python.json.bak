        "input": "is_palindrome('hello')",
        "expected_output": "False",
        "description": "is_palindrome('hello') 应返回 False"
      },
      {
        "input": "reverse_string('')",
        "expected_output": "",
        "description": "reverse_string('') 应返回 ''（空字符串边界）"
      }
    ],
