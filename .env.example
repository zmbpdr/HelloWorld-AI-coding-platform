# Hello World 环境变量配置
# 使用方式：复制此文件为 .env 并填入实际值
# copy .env.example .env

# 数据库（SQLite 本地开发）
DATABASE_URL=sqlite+aiosqlite:///./codequest.db

# Redis
REDIS_URL=redis://localhost:6379

# JWT 密钥（生产环境务必修改）
SECRET_KEY=change-me-in-production

# 代码执行（跳过 Docker，直接 subprocess 执行）
ALLOW_DIRECT_EXECUTION=true

# AI 服务
OLLAMA_BASE_URL=http://localhost:11434
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_MODEL=deepseek-v4-flash
AI_PROVIDER_PRIORITY=deepseek,ollama,mock

# 管理员账号
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@helloworld.com
ADMIN_PASSWORD=admin123

# CORS
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# 功能开关
FEATURE_DIAGNOSTIC=true
FEATURE_KNOWLEDGE=true
FEATURE_ERROR_BOOK=true
FEATURE_STRUCTURED_REVIEW=true
FEATURE_RECOMMEND=true
FEATURE_WEEKLY_REPORT=false
FEATURE_MEMBERSHIP=false

# 课程内容数据目录
CONTENT_DIR=../codequest-content/lessons

# SQL 日志（开发环境开启）
SQL_ECHO=false